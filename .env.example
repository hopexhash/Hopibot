# ── Core (required) ───────────────────────────────────────────────
# Supabase Postgres connection string (Project Settings → Database). Use the pooler on
# port 6543 for serverless, or the direct connection for the worker.
DATABASE_URL=postgres://postgres:password@localhost:5432/agencyos
REDIS_URL=redis://localhost:6379
# 32+ random characters; encrypts integration secrets at rest. `openssl rand -base64 32`
APP_ENCRYPTION_KEY=
APP_URL=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────
# local = built-in email/password; supabase = Supabase Auth
AUTH_PROVIDER=local
ALLOW_SIGNUP=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development only: integrations without credentials return clearly labelled MOCK data.
# Refused when NODE_ENV=production.
ALLOW_MOCK_MODE=false

# ── Integrations (optional here; can also be added on the Integrations page) ──
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
HUNTER_API_KEY=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
AGENCYOS_GITHUB_TOKEN=
AGENCYOS_GITHUB_OWNER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ── Worker ────────────────────────────────────────────────────────
# Optional: restrict a worker process to some agents, e.g. "quality_control,deployment"
WORKER_AGENTS=
QC_CONCURRENCY=2
